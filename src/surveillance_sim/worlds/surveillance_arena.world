    <model name="cam_pillar_north">
      <static>true</static>
      <pose>4.700 3.200 7.200 0 0.7192 -2.2058</pose>
      <link name="camera_link">
        <visual name="cam_housing">
          <geometry><box><size>0.35 0.15 0.15</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <visual name="cam_lens">
          <pose>0.18 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor type="camera" name="cam_pillar_north_sensor">
          <topic>cam_pillar_north/image</topic>
          <update_rate>20.0</update_rate>
          <camera name="head">
            <horizontal_fov>1.22</horizontal_fov>
            <image>
              <width>640</width>
              <height>640</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.2</near>
              <far>50.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
